# =============================================================================
# TRAVEL BOOKING SYSTEM - BACKEND ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values. Never commit ".env".
# =============================================================================

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- Database ------------------------------------------------------------------
# MongoDB Atlas connection string (see README "MANUAL TASKS REQUIRED FROM ME")
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/travel-booking?retryWrites=true&w=majority

# --- Authentication ------------------------------------------------------------
# A long, random, secret string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRE=7d

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slash, no wildcard)
CORS_ORIGIN=http://localhost:5173

# --- Frontend URL (used in email links, etc.) -----------------------------------
CLIENT_URL=http://localhost:5173

# --- Stripe (Payments) ------------------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# From https://dashboard.stripe.com/test/webhooks (after creating the webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# --- Email (Nodemailer / SMTP) ------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="Travel Booking System <your_email@gmail.com>"

# --- Google OAuth (optional - only needed if Google login is added later) -----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Seed script (npm run seed) -----------------------------------------------
# Optional overrides for the test accounts created by seed/seed.js.
# If omitted, the defaults shown below are used.
SEED_ADMIN_EMAIL=admin@DF Travel System.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_EMAIL=jane@DF Travel System.test
SEED_USER_PASSWORD=User1234!
