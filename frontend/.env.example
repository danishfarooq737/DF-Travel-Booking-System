# =============================================================================
# TRAVEL BOOKING SYSTEM - FRONTEND ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values. Never commit ".env".
# Only variables safe to expose in the browser belong here (Vite inlines
# every VITE_-prefixed variable into the built JS bundle at build time).
# =============================================================================

# Base URL of the backend API (no trailing slash), e.g.:
#   Local development: http://localhost:5000/api
#   Production:         https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Stripe PUBLISHABLE key (safe for the browser). Get it from
# https://dashboard.stripe.com/test/apikeys — this is the "Publishable key",
# NOT the "Secret key". The secret key must only ever live in the backend .env.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# -----------------------------------------------------------------------------
# Used ONLY by the local Node seed script (seed/seed.js), never bundled into
# the browser (it is not prefixed with VITE_, so Vite ignores it in the app).
# Point this at the SAME MongoDB database your backend's MONGODB_URI uses.
# -----------------------------------------------------------------------------
SEED_MONGODB_URI=mongodb://127.0.0.1:27017/travel-booking-system
SEED_ADMIN_EMAIL=admin@DF Travel System.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_EMAIL=jane@DF Travel System.test
SEED_USER_PASSWORD=User1234!
